pipeline {
    agent any

    stages {

        stage('Execute Watermelon Test Pack') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'watermelon',
                        usernameVariable: 'WM_USERNAME',
                        passwordVariable: 'WM_PASSWORD'
                    )
                ]) {
                    powershell '''
                    Write-Host "TEST"
                    '''
                }
            }
        }

        stage('Monitor Execution') {
            steps {
                powershell '''
                Write-Host "MONITOR"
                '''
            }
        }

    }
}
