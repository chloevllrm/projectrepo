pipeline {
    agent any

    stages {

        stage('Get Watermelon Token') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'watermelon',
                        usernameVariable: 'WM_USERNAME',
                        passwordVariable: 'WM_PASSWORD'
                    )
                ]) {
                    powershell '''
                    $body = @{
                        client_id="web_app"
                        username=$env:WM_USERNAME
                        password=$env:WM_PASSWORD
                        grant_type="password"
                    }

                    $response = Invoke-RestMethod `
                      -Method POST `
                      -Uri "https://wm-sandbox-auth-1.watermelon.us/realms/watermelon/protocol/openid-connect/token" `
                      -ContentType "application/x-www-form-urlencoded" `
                      -Body $body

                    Write-Host "TOKEN RECEIVED"
                    Write-Host $response.access_token.Substring(0,20)
                    '''
                }
            }
        }
    }
}
